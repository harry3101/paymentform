# Razorpay — required for automatic payment verification
# Get keys: https://dashboard.razorpay.com/app/keys
# Use Test keys while developing; Live keys in production.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Optional but recommended — Dashboard → Webhooks
# URL: https://<your-render-domain>/api/payment/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
